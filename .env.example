# ANTHROPIC_API_KEY: Required for all AI features (semantic search + copilots).
# Get one at https://console.anthropic.com/ -> Settings -> API Keys.
# Copy this file to ".env" and paste your real key in place of the placeholder.
# The .env file is git-ignored, so your key never gets committed.
ANTHROPIC_API_KEY="sk-ant-your-key-here"

# --- Required once NODE_ENV=production (the server refuses to start without
# these two — see the startup guard in server.ts). Each is just a long random
# secret used to sign session/portal cookies; generate with, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without a fixed value here, every server restart invalidates all signed-in
# sessions and every outstanding client portal link.
PORTAL_SECRET=""
SESSION_SECRET=""

# DATA_DIR: where desboard.db and uploads/ are stored. Leave unset for local
# dev (defaults to the project directory). On a host with an ephemeral
# filesystem between deploys (Railway, Fly, etc.), point this at your
# mounted persistent volume, e.g. "/data" — otherwise every deploy wipes the
# database and every uploaded file.
DATA_DIR=""

# APP_BASE_URL: this server's real public URL (e.g. "https://app.yourstudio.com"),
# used to build links in the background client-reminder email sweep, which has
# no incoming request to derive a URL from. Leave unset for local dev.
APP_BASE_URL=""

# RESEND_API_KEY / REMINDER_FROM_EMAIL: enables real delivery of client
# reminder emails ("this handover hasn't been opened in N days"). Get a key
# at https://resend.com. Without it, reminders are logged to the server
# console instead of sent — the app still works, nothing breaks.
RESEND_API_KEY=""
REMINDER_FROM_EMAIL="Your Studio <onboarding@resend.dev>"

# VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY: Your Supabase project's
# API URL and publishable (anon) key, from Project Settings -> API in the
# Supabase dashboard. The VITE_ prefix is required for Vite to expose these to
# browser code (see vite.dev/guide/env-and-mode) — this is Vite's equivalent
# of Next.js's NEXT_PUBLIC_ prefix. The publishable key is safe to expose
# client-side by design; never put a service_role/secret key behind this
# prefix.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your-key-here"

# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET: Enables the real "Connect Google
# Drive" flow (Settings -> Connections). Create an OAuth 2.0 Client ID at
# https://console.cloud.google.com/apis/credentials (Web application type),
# and add this server's callback URL as an Authorized redirect URI — for
# local dev that's http://localhost:3000/api/oauth/google/callback. While the
# consent screen is in "Testing" publishing status, only test users you add
# in the Cloud Console can complete sign-in; add your own Google account.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# DROPBOX_APP_KEY / DROPBOX_APP_SECRET: Enables the real "Connect Dropbox"
# flow. Create an app at https://www.dropbox.com/developers/apps (scoped
# access, "files.metadata.read" + "files.content.read" + "account_info.read"
# permissions), and add this server's callback URL under OAuth 2 -> Redirect
# URIs — for local dev that's http://localhost:3000/api/oauth/dropbox/callback.
DROPBOX_APP_KEY=""
DROPBOX_APP_SECRET=""

# --- "Sign in with ..." (login, not file access — see the three below) ------

# Reuses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above for "Sign in with
# Google" too — the same Google Cloud OAuth client can register multiple
# redirect URIs. Add a SECOND Authorized redirect URI on that same credential:
# http://localhost:3000/api/auth/sso/google/callback

# MICROSOFT_CLIENT_ID / MICROSOFT_CLIENT_SECRET: Enables "Sign in with
# Microsoft" AND the real "Connect OneDrive" flow (Settings -> Connections) —
# one Azure app registration, two redirect URIs, same dual-purpose pattern as
# GOOGLE_CLIENT_ID above. Register an app at https://portal.azure.com ->
# Azure Active Directory -> App registrations ("Web" platform, "Accounts in
# any organizational directory and personal Microsoft accounts"), grant it
# the delegated Microsoft Graph permission "Files.Read", and add BOTH redirect
# URIs: http://localhost:3000/api/auth/sso/microsoft/callback (sign-in) and
# http://localhost:3000/api/oauth/onedrive/callback (file connection).
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# APPLE_CLIENT_ID / APPLE_TEAM_ID / APPLE_KEY_ID / APPLE_PRIVATE_KEY: Enables
# "Sign in with Apple". Requires a paid Apple Developer Program membership.
# At https://developer.apple.com/account -> Certificates, Identifiers &
# Profiles: create an App ID, then a Services ID (this is APPLE_CLIENT_ID,
# e.g. "com.desboard.web") with "Sign in with Apple" enabled and a registered
# return URL — https://<your-domain>/api/auth/sso/apple/callback. Apple does
# NOT allow http://localhost redirect URIs at all, so this one can't be
# click-tested on local dev without a tunnel (e.g. ngrok) pointed at this
# server. Then create a "Sign in with Apple" private key (a .p8 file) — its
# 10-character Key ID is APPLE_KEY_ID, your 10-character Team ID (top-right
# of the developer portal) is APPLE_TEAM_ID, and APPLE_PRIVATE_KEY is that
# .p8 file's PEM contents pasted inside the quotes below (real newlines are
# fine here; a "\n"-escaped single line also works, code handles both).
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# --- Stripe billing (paid plans) --------------------------------------------
#
# Without STRIPE_SECRET_KEY set, the app runs completely normally — every
# workspace still gets its 14-day trial, the landing page and /pricing render
# fine, and GET /api/billing/status returns real trial data. Only checking
# out into a paid plan (or opening the Billing Portal) is disabled, with a
# friendly error instead of a crash. Nothing here is required for local dev.

# STRIPE_SECRET_KEY: your Stripe secret key, from
# https://dashboard.stripe.com/test/apikeys while in Test mode (starts with
# "sk_test_"; switch to a "sk_live_" key only once you're ready to take real
# payments). Restart the server after adding it.
STRIPE_SECRET_KEY=""

# STRIPE_WEBHOOK_SECRET: verifies that POST /api/billing/webhook requests
# really came from Stripe (checkout completions, renewals, cancellations all
# arrive this way — nothing here is polled). For local dev, install the
# Stripe CLI and run:
#   stripe listen --forward-to localhost:3000/api/billing/webhook
# It prints a "whsec_..." value on startup — that's this variable, and it
# stays valid for as long as that `stripe listen` process keeps running. For
# a deployed server, create a real webhook endpoint instead at
# https://dashboard.stripe.com/test/webhooks pointing at
# https://<your-domain>/api/billing/webhook, listening for at least
# checkout.session.completed, customer.subscription.updated, and
# customer.subscription.deleted — that endpoint's own "Signing secret" is
# this value.
STRIPE_WEBHOOK_SECRET=""

# STRIPE_PRICE_FREELANCE_MONTHLY / _ANNUAL / STRIPE_PRICE_STUDIO_MONTHLY /
# _ANNUAL: the Price IDs (start with "price_") checkout uses for each plan.
# Create one Product per tier at https://dashboard.stripe.com/test/products
# ("Freelance", "Studio"), each with two recurring Prices — monthly and
# yearly, matching the numbers in src/components/PricingCards.tsx — and paste
# each Price's ID below. A tier with no price ID set here simply can't be
# checked out into yet; the other tiers keep working.
STRIPE_PRICE_FREELANCE_MONTHLY=""
STRIPE_PRICE_FREELANCE_ANNUAL=""
STRIPE_PRICE_STUDIO_MONTHLY=""
STRIPE_PRICE_STUDIO_ANNUAL=""
